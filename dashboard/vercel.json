{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_RENDER_BACKEND.onrender.com/api/$1"
    },
    {
      "source": "/terminal",
      "destination": "/index.html"
    },
    {
      "source": "/copilot",
      "destination": "/manual.html"
    },
    {
      "source": "/manual",
      "destination": "/manual.html"
    },
    {
      "source": "/",
      "destination": "/manual.html"
    }
  ]
}
