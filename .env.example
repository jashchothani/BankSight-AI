# ===========================================================================
# BankSight AI — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# ===========================================================================

# --- Mode ---
# auto = demo if required API keys missing, live if available
# demo = always use bundled sample data
# live = require real data sources (fail if unavailable)
MODE=live

# --- Data Providers ---
# Options: yfinance (default, free, no key needed)
DATA_PROVIDER=yfinance
NEWS_PROVIDER=yfinance
MACRO_PROVIDER=static
FUNDAMENTALS_PROVIDER=yfinance

# --- API Keys (leave blank to use free defaults) ---
MARKET_DATA_API_KEY=
NEWS_API_KEY=
MACRO_API_KEY=

# --- Historical Data ---
# Start date for historical data download (YYYY-MM-DD)
HISTORY_START=2015-01-01

# --- Kafka (optional, disabled by default) ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO

# --- SMTP Configuration (Optional, for email alerts/reports) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jashthakkar77@gmail.com
SMTP_PASSWORD=pbsugwsmyxvkhavw
SMTP_FROM=jashthakkar77@gmail.com
