{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://banksight-ai-backend.onrender.com/api/$1"
    },
    {
      "source": "/terminal",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/copilot",
      "destination": "/dashboard/manual.html"
    },
    {
      "source": "/manual",
      "destination": "/dashboard/manual.html"
    },
    {
      "source": "/",
      "destination": "/dashboard/manual.html"
    },
    {
      "source": "/(.*)",
      "destination": "/dashboard/$1"
    }
  ]
}